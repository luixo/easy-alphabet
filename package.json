		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-i18next": "^15.6.1",
		"remeda": "^2.30.0",
		"tailwind-merge": "^3.3.1",
		"usehooks-ts": "^3.1.1"
	},
	"devDependencies": {
		"@luixo/configs": "0.1.0",
		"@tailwindcss/postcss": "^4.1.12",
		"@tailwindcss/vite": "^4.1.12",
		"@types/country-flag-icons": "^1.2.2",
		"@types/node": "^24.3.0",
		"@types/react": "^19.1.10",
